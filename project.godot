config_version=5

[application]
config/name="ROOTKIT"
config/version="0.1.0"
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://scenes/main.tscn"

[autoload]

Updater="*res://scripts/update/updater.gd"
CRTOverlay="*res://scripts/ui/crt_overlay.gd"

[physics]
common/physics_ticks_per_second=60

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.016, 0.031, 0.027, 1)
viewport/hdr_2d=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
; ADAPTIVE (2), not the default ENABLED (1). Blocking vsync has exactly two
; speeds on a 60 Hz panel: a frame that fits shows at 60, and a frame that
; misses by ONE MILLISECOND waits for the whole next interval and shows at 30.
; Adaptive lets a missed frame through at the speed it actually ran instead of
; halving it, and Godot falls back to ENABLED where the driver has no adaptive
; mode, so it is safe on every target.
;
; Honest about what this was measured to do HERE: nothing. On an M2 at
; fullscreen with a four-slot party and ~450 live enemies, tools/fps_probe.gd
; reports the same distribution under both modes (median 16.66 ms, p95 17.5 vs
; 17.4) because the uncapped frame is 9.5 ms and never misses — there is no
; halving on this machine to prevent. It is kept as insurance for a machine
; where the frame does sit on the line, where the difference is 60 fps against
; 30, and it costs nothing to carry.
window/vsync/vsync_mode=2

[input]

; Actions, not raw keycodes, so one rule serves both devices. Movement reads
; both axes through Input.get_vector, which brings analog sticks along for free;
; the overlay reads the same actions, without which a gamepad player could walk
; and pause but never operate the build system the game is named for.
;
; `recipes` and `restart` share R because ui.gd already bound R to restart on
; the end screen while R toggles the recipe panel elsewhere. They are two
; actions because a gamepad has no shared button to disambiguate; the routing
; decides between them by screen.

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65,"pressed":false,"echo":false,"script":null)
, Object(InputEventKey,"physical_keycode":4194319,"pressed":false,"echo":false,"script":null)
, Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0,"script":null)
, Object(InputEventJoypadButton,"button_index":13,"pressed":false,"script":null)
]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68,"pressed":false,"echo":false,"script":null)
, Object(InputEventKey,"physical_keycode":4194321,"pressed":false,"echo":false,"script":null)
, Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0,"script":null)
, Object(InputEventJoypadButton,"button_index":14,"pressed":false,"script":null)
]
}
move_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87,"pressed":false,"echo":false,"script":null)
, Object(InputEventKey,"physical_keycode":4194320,"pressed":false,"echo":false,"script":null)
, Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0,"script":null)
, Object(InputEventJoypadButton,"button_index":11,"pressed":false,"script":null)
]
}
move_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83,"pressed":false,"echo":false,"script":null)
, Object(InputEventKey,"physical_keycode":4194322,"pressed":false,"echo":false,"script":null)
, Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0,"script":null)
, Object(InputEventJoypadButton,"button_index":12,"pressed":false,"script":null)
]
}
aim_left={
"deadzone": 0.25,
"events": [Object(InputEventJoypadMotion,"axis":2,"axis_value":-1.0,"script":null)
]
}
aim_right={
"deadzone": 0.25,
"events": [Object(InputEventJoypadMotion,"axis":2,"axis_value":1.0,"script":null)
]
}
aim_up={
"deadzone": 0.25,
"events": [Object(InputEventJoypadMotion,"axis":3,"axis_value":-1.0,"script":null)
]
}
aim_down={
"deadzone": 0.25,
"events": [Object(InputEventJoypadMotion,"axis":3,"axis_value":1.0,"script":null)
]
}
confirm={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194309,"pressed":false,"echo":false,"script":null)
, Object(InputEventKey,"physical_keycode":4194310,"pressed":false,"echo":false,"script":null)
, Object(InputEventKey,"physical_keycode":32,"pressed":false,"echo":false,"script":null)
, Object(InputEventJoypadButton,"button_index":0,"pressed":false,"script":null)
]
}
cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194305,"pressed":false,"echo":false,"script":null)
, Object(InputEventJoypadButton,"button_index":1,"pressed":false,"script":null)
]
}
pause={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"button_index":6,"pressed":false,"script":null)
]
}
recipes={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":82,"pressed":false,"echo":false,"script":null)
, Object(InputEventJoypadButton,"button_index":3,"pressed":false,"script":null)
]
}
restart={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":82,"pressed":false,"echo":false,"script":null)
, Object(InputEventJoypadButton,"button_index":2,"pressed":false,"script":null)
]
}
; F1 toggles the network diagnostics panel during a session. Keyboard-only:
; there is no spare gamepad button a fighting player would not hit by accident.
; 4194332 is KEY_F1 (4194304 + 0x1C); 4194336 would be F5.
netinfo={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194332,"pressed":false,"echo":false,"script":null)
]
}
